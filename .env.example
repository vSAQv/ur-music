# Navidrome configuration
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASS=your_navidrome_password

# ListenBrainz configuration
LISTENBRAINZ_TOKEN=your_listenbrainz_user_token
LISTENBRAINZ_USER=your_listenbrainz_username

# SLSKD configuration
SLSKD_URL=http://localhost:5030
SLSKD_USERNAME=admin
SLSKD_PASSWORD=your_slskd_password

# MeTube & LiteLLM URLs
METUBE_URL=http://localhost:8081
LITELLM_URL=http://localhost:4000

# OpenRouter configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Spotify credentials (optional, for playlist parsed via other methods if needed)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Playlists to synchronize (comma-separated URLs)
PLAYLIST_URLS=https://www.youtube.com/playlist?list=...,https://music.yandex.com/...

# Paths
DOWNLOAD_DIR=/home/cif/homelab/data/music
MUSIC_ROOT_CONTAINER=/music
TRASH_DIR=/home/cif/homelab/data/music/.trash
TRASH_DAYS=7

# Config and state file locations
HISTORY_FILE=/home/cif/homelab/config/sync_music/sync_history.json
STATE_FILE=/home/cif/homelab/config/sync_music/discovery_state.json
SYNC_QUEUE_FILE=/home/cif/homelab/config/sync_music/download_queue.json

# Log file locations
SYNC_LOG_FILE=/home/cif/homelab/config/sync_music/sync_music.log
DISCOVERY_LOG_FILE=/home/cif/homelab/config/sync_music/discovery.log
DELETE_DAEMON_LOG_FILE=/home/cif/homelab/config/sync_music/delete_daemon.log

# Tuning Parameters
TOLERANCE_SEC=12
SEARCH_TIMEOUT=90
QUEUE_TIMEOUT_HOURS=4
MAX_RETRIES=3
LLM_SHORT_TITLE_WORDS=3

SUBMIT_LISTENS_COUNT=200
WEEKLY_COUNT=20
MONTHLY_COUNT=40
WEEKLY_NAME=🔮 Discover Weekly
MONTHLY_NAME=🌙 Discover Monthly

DELETE_PLAYLIST=🗑 Delete Queue
PROTECT_STARRED=True
POLL_INTERVAL=300
